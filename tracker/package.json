{
  "name": "crewmeter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "crewmeter": "dist/cli.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "bun build src/cli.ts src/collect-worker.ts --target=node --packages=external --outdir=dist && cp src/aggregate.js src/trend.js dist/",
    "prepack": "bun run build",
    "test": "bun test --timeout 30000",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/bun": "1.3.1",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2"
  }
}
